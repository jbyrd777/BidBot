# Every service is optional. Without any keys the team runs on its built in skills over demo data.

# Language model: any OpenAI compatible chat API (OpenAI, xAI Grok, and others)
MODEL_API_KEY=
MODEL_NAME=
MODEL_BASE_URL=            # leave empty for OpenAI; for Grok use https://api.x.ai/v1

# Cloud computers for the bots (live screens, take over)
COMPUTER_API_KEY=

# Connected apps (email, calendar, drives, CRM, accounting, bid platforms)
CONNECTOR_API_KEY=

# Long term memory
MEMORY_API_KEY=

# The main bot's own email address
MAIL_API_KEY=
MAIL_DOMAIN=

# The main bot's phone number for texts and calls
PHONE_API_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Fix "today" for demos and tests
DEMO_TODAY=
